\uc0\u1071  \u1074 \u1088 \u1077 \u1084 \u1103  \u1074  \u1101 \u1090 \u1086 \u1084  \u1074 \u1086 \u1076 \u1077  \u1089 \u1077 \u1081 \u1095 \u1072 \u1089  \u1079 \u1080 \u1084 \u1086 \u1081  \u1074 \u1086 \u1090  \u1084 \u1099  \u1089 \u1077 \u1081 \u1095 \u1072 \u1089  \u1091 \u1090 \u1088 \u1086 \u1084  \u1074 \u1095 \u1077 \u1088 \u1072  \u1087 \u1086 \u1077 \u1093 \u1072 \u1083 \u1080  \u1074  \u1041 \u1088 \u1072 \u1089 \u1083 \u1072 \u1074 \u1089  \u1085 \u1072 \u1095 \u1072 \u1083 \u1080  \u1082 \u1086 \u1085 \u1089 \u1090 \u1088 \u1091 \u1080 \u1088 \u1086 \u1074 \u1072 \u1090 \u1100  \u1085 \u1086 \u1074 \u1086  \u1085 \u1086 \u1074 \u1086 \u1077  \u1086 \u1073 \u1086 \u1088 \u1091 \u1076 \u1086 \u1074 \u1072 \u1085 \u1080 \u1077 , \u1087 \u1086 \u1090 \u1086 \u1084 \u1091  \u1095 \u1090 \u1086  \u1103  \u1091 \u1078 \u1077  \u1091 \u1089 \u1090 \u1072 \u1083  \u1089 \u1080 \u1076 \u1077 \u1090 \u1100  \u1075 \u1086 \u1085 \u1082 \u1080  \u1079 \u1072 \u1082 \u1086 \u1085 \u1095 \u1080 \u1083 \u1080 \u1089 \u1100 . \u1047 \u1085 \u1072 \u1077 \u1096 \u1100 , \u1103  \u1087 \u1088 \u1086 \u1074 \u1086 \u1083  \u1085 \u1077  \u1082 \u1086 \u1088 \u1086 \u1095 \u1077  \u1089 \u1083 \u1091 \u1096 \u1072 \u1081  \u1087 \u1086 \u1083 \u1085 \u1086 \u1077  \u1080 \u1089 \u1090 \u1086 \u1097 \u1077 \u1085 \u1080 \u1077  \u1084 \u1072 \u1096 \u1080 \u1085 \u1099 , \u1079 \u1085 \u1072 \u1077 \u1096 \u1100  \u1082 \u1072 \u1082 \u1086 \u1077  \u1087 \u1086 \u1083 \u1085 \u1086 \u1077  \u1080 \u1089 \u1090 \u1086 \u1097 \u1077 \u1085 \u1080 \u1077  \u1086 \u1088 \u1075 \u1072 \u1085 \u1080 \u1079 \u1084 \u1072 , \u1082 \u1086 \u1085 \u1077 \u1095 \u1085 \u1086 .\
\uc0\u1050 \u1086 \u1075 \u1076 \u1072  \u1074 \u1089 \u1077  \u1084 \u1080 \u1082 \u1088 \u1086 \u1085 \u1091 \u1090 \u1088 \u1080 \u1077 \u1085 \u1090 \u1099 , \u1082 \u1086 \u1075 \u1076 \u1072  \u1074 \u1089 \u1077  \u1089 \u1086 \u1083 \u1080 , \u1074 \u1089 \u1105  \u1074 \u1099 \u1084 \u1099 \u1090 \u1086  \u1080 \u1079  \u1086 \u1088 \u1075 \u1072 \u1085 \u1080 \u1079 \u1084 \u1072 . \u1048  \u1090 \u1099  \u1089 \u1080 \u1076 \u1080 \u1096 \u1100  \u1085 \u1072  \u1087 \u1086 \u1089 \u1090 \u1077 , \u1080  \u1075 \u1083 \u1102 \u1082 \u1086 \u1079 \u1099  \u1085 \u1080 \u1082 \u1072 \u1082 \u1086 \u1081  \u1085 \u1077 \u1090 , \u1082 \u1086 \u1090 \u1086 \u1088 \u1072 \u1103  \u1085 \u1077 \u1086 \u1073 \u1093 \u1086 \u1076 \u1080 \u1084 \u1072  \u1076 \u1083 \u1103  \u1089 \u1090 \u1088 \u1072 \u1085 \u1085 \u1086 \u1081  \u1085 \u1077 \u1088 \u1074 \u1085 \u1086 \u1081  \u1089 \u1080 \u1089 \u1090 \u1077 \u1084 \u1099 , \u1087 \u1086 \u1090 \u1086 \u1084 \u1091  \u1095 \u1090 \u1086  \u1084 \u1086 \u1090 \u1086 \u1075 \u1086 \u1085 \u1082 \u1080  - \u1101 \u1090 \u1086  \u1087 \u1088 \u1086  \u1088 \u1072 \u1073 \u1086 \u1090 \u1091  \u1084 \u1086 \u1079 \u1075 \u1072 ,\
\uc0\u1076 \u1072 ?\
\uc0\u1040  \u1089 \u1082 \u1086 \u1088 \u1086 \u1089 \u1090 \u1100  \u1088 \u1077 \u1072 \u1082 \u1094 \u1080 \u1080  \u1080  \u1085 \u1072 \u1073 \u1083 \u1102 \u1076 \u1077 \u1085 \u1080 \u1103 . \u1071  \u1077 \u1076 \u1091 , \u1073 \u1083 \u1080 \u1085 , \u1095 \u1077 \u1084  \u1073 \u1086 \u1083 \u1100 \u1096 \u1077  \u1103  \u1090 \u1088 \u1077 \u1085 \u1080 \u1088 \u1091 \u1102 \u1089 \u1100 , \u1090 \u1077 \u1084  \u1084 \u1077 \u1095 \u1077  \u1090 \u1077 \u1084  \u1084 \u1077 \u1076 \u1083 \u1077 \u1085 \u1085 \u1077 \u1077  \u1103  \u1077 \u1076 \u1091 . \u1071  \u1087 \u1088 \u1080 \u1093 \u1086 \u1078 \u1091  \u1082  \u1090 \u1088 \u1077 \u1085 \u1077 \u1088 \u1091 , \u1075 \u1086 \u1074 \u1086 \u1088 \u1102 : "\u1045 \u1075 \u1086 \u1088 , \u1072  \u1095 \u1090 \u1086  \u1085 \u1091 \u1078 \u1085 \u1086  \u1089 \u1076 \u1077 \u1083 \u1072 \u1090 \u1100 ?" \u1054 \u1085  \u1075 \u1086 \u1074 \u1086 \u1088 \u1080 \u1090 : "\u1069 , \u1082 \u1086 \u1082 \u1072 \u1080 \u1085  \u1087 \u1088 \u1086 \u1073 \u1086 \u1074 \u1072 \u1083 ?" \u1071  \u1075 \u1086 \u1074 \u1086 \u1088 \u1102 : "\u1073 **, \u1085 \u1077 , \u1085 \u1077 , \u1085 \u1077 , \u1085 \u1077  \u1087 \u1088 \u1086 \u1073 \u1086 \u1074 \u1072 \u1083 ", \u1075 \u1086 \u1074 \u1086 \u1088 \u1080 \u1090 : "\u1050 \u1086 \u1082 \u1072 \u1080 \u1085 ". \u1040 , \u1075 \u1086 \u1074 \u1086 \u1088 \u1080 \u1090 : "\u1053 \u1091  \u1074 \u1089 \u1105 , \u1074 \u1086 \u1087 \u1088 \u1086 \u1089 \u1099  \u1079 \u1072 \u1076 \u1072 \u1105 \u1096 \u1100  \u1082 \u1072 \u1087 \u1077 \u1083 \u1100 \u1085 \u1080 \u1094 \u1091  \u1087 \u1086 \u1087 \u1088 \u1086 \u1073 \u1091 \u1102 ". \u1071  \u1075 \u1086 \u1074 \u1086 \u1088 \u1102 : "\u1054 , \u1073 \u1083 \u1080 \u1085 , \u1082 \u1072 \u1087 \u1077 \u1083 \u1100 \u1085 \u1080 \u1094 \u1072 , \u1090 \u1086 , \u1095 \u1090 \u1086  \u1085 \u1072 \u1076 \u1086 ". \u1047 \u1074 \u1086 \u1085 \u1102  \u1089 \u1074 \u1086 \u1077 \u1084 \u1091  \u1076 \u1088 \u1091 \u1075 \u1091  \u1074  \u1055 \u1086 \u1088 \u1090 \u1091 \u1075 \u1072 \u1083 \u1080 \u1080 , \u1075 \u1086 \u1074 \u1086 \u1088 \u1102 : "\u1052 \u1086 \u1078 \u1085 \u1086  \u1075 \u1086 \u1074 \u1086 \u1088 \u1080 \u1090 \u1100 \u1089 \u1103 ? \u1044 \u1086 \u1075 \u1086 \u1074 \u1086 \u1088 \u1080 \u1083 \u1089 \u1103  \u1090 \u1072 \u1084  \u1074  \u1073 \u1086 \u1083 \u1100 \u1085 \u1080 \u1095 \u1082 \u1091  \u1087 \u1086 \u1077 \u1093 \u1072 \u1083 , \u1074  \u1087 \u1103 \u1090 \u1085 \u1080 \u1094 \u1091  \u1079 \u1072 \u1082 \u1086 \u1085 \u1095 \u1080 \u1083 \u1080 , \u1087 \u1086 \u1075 \u1086 \u1085 \u1103 \u1083 , \u1087 \u1086 \u1090 \u1088 \u1077 \u1085 \u1080 \u1088 \u1086 \u1074 \u1072 \u1083 \u1089 \u1103 . \u1042  \u1074 \u1086 \u1089 \u1082 \u1088 \u1077 \u1089 \u1077 \u1085 \u1100 \u1077  \u1075 \u1086 \u1085 \u1082 \u1072 . \u1071  \u1087 \u1086 \u1085 \u1080 \u1084 \u1072 \u1102 , \u1095 \u1090 \u1086  \u1103  \u1089 \u1083 \u1072 \u1076 \u1082 \u1086  \u1085 \u1077  \u1077 \u1084 . \u1044 \u1072  \u1095 \u1090 \u1086  \u1076 \u1077 \u1083 \u1072 \u1090 \u1100 ? \u1071  \u1079 \u1072 \u1083 \u1077 \u1090 \u1072 \u1102  \u1082 \u1090 \u1099 \u1095 \u1082 \u1077  \u1086 \u1085 \u1072  \u1091  \u1084 \u1077 \u1085 \u1103  \u1080 \u1085 \u1089 \u1090 \u1072 \u1083 \u1103 \u1090 \u1086 \u1088 . \u1055 \u1086 \u1083 \u1083 \u1080 \u1090 \u1088 \u1072  \u1083 \u1080 \u1088 \u1080 \u1085 \u1075 \u1077 \u1088 \u1072 , \u1087 \u1086 \u1083 \u1083 \u1080 \u1090 \u1088 \u1072  \u1075 \u1083 \u1102 \u1082 \u1086 \u1079 \u1099 . \u1055 \u1086 \u1090 \u1086 \u1084 , \u1082 \u1086 \u1075 \u1076 \u1072  \u1075 \u1083 \u1102 \u1082 \u1086 \u1079 \u1072  \u1087 \u1086 \u1096 \u1083 \u1072 , \u1103  \u1085 \u1072 \u1095 \u1072 \u1083  \u1091 \u1078 \u1077  \u1080 \u1089 \u1082 \u1072 \u1090 \u1100 , \u1087 \u1086 \u1095 \u1077 \u1084 \u1091  \u1091  \u1084 \u1077 \u1085 \u1103  \u1084 \u1099 \u1096 \u1090 \u1072  \u1087 \u1088 \u1086 \u1087 \u1072 \u1083 \u1072  \u1090 \u1088 \u1072 \u1087 \u1077 \u1094 \u1080 \u1090 \u1072 . \u1058 \u1072 \u1084 , \u1073 \u1083 \u1080 \u1085 , \u1082 \u1086 \u1088 \u1086 \u1095 \u1077 , \u1074 \u1089 \u1105 , \u1103  \u1077 \u1075 \u1086  \u1085 \u1077  \u1080 \u1076 \u1091 \u1090 . \u1071  \u1091 \u1078 \u1077  \u1087 \u1086 \u1076 \u1091 \u1084 \u1072 \u1083 , \u1095 \u1090 \u1086  \u1085 \u1077 \u1088 \u1074 \u1099  \u1087 \u1088 \u1080 \u1096 \u1083 \u1089 \u1103 . \u1050 \u1086 \u1088 \u1086 \u1095 \u1077 , \u1084 \u1086 \u1079 \u1075  \u1084 \u1086 \u1081  \u1085 \u1072 \u1095 \u1080 \u1085 \u1072 \u1077 \u1090  \u1088 \u1072 \u1073 \u1086 \u1090 \u1072 \u1090 \u1100 , \u1082 \u1072 \u1087 \u1077 \u1094 . \u1057 \u1083 \u1091 \u1096 \u1072 \u1081 , \u1103  \u1090 \u1072 \u1082 \u1086 \u1081  \u1089 \u1080 \u1078 \u1091 , \u1087 \u1088 \u1080 \u1093 \u1086 \u1076 \u1080 \u1090 , \u1087 \u1086 \u1073 \u1086 \u1076 \u1088 \u1077 \u1077  \u1089 \u1090 \u1072 \u1083 \u1086 . \u1057 \u1072 \u1078 \u1091 \u1089 \u1100  \u1074  \u1084 \u1072 \u1096 \u1080 \u1085 \u1091 , \u1074 \u1082 \u1083 \u1102 \u1095 \u1072 \u1102  \u1084 \u1091 \u1079 \u1099 \u1082 \u1091 . \u1050 \u1072 \u1078 \u1076 \u1072 \u1103  \u1085 \u1086 \u1090 \u1072 , \u1082 \u1072 \u1078 \u1076 \u1072 \u1103  \u1085 \u1086 \u1090 \u1072  \u1073 \u1072 \u1091 \u1073 \u1072 \u1091  \u1073 \u1072 \u1091 . \u1071  \u1074  \u1084 \u1072 \u1075 \u1072 \u1079 \u1080 \u1085  \u1087 \u1086 \u1082 \u1091 \u1087 \u1072 \u1102  \u1087 \u1088 \u1086 \u1076 \u1091 \u1082 \u1090 \u1099  \u1090 \u1072 \u1084  \u1074 \u1089 \u1105 . \u1055 \u1088 \u1080 \u1077 \u1079 \u1078 \u1072 \u1102  \u1076 \u1086 \u1084 \u1086 \u1081 , \u1075 \u1088 \u1080 \u1073 \u1099  \u1087 \u1086 \u1082 \u1091 \u1087 \u1072 \u1102 , \u1090 \u1072 \u1084  \u1083 \u1091 \u1082 \u1072  \u1086 \u1073 \u1099 \u1095 \u1085 \u1086  \u1090 \u1072 \u1084  \u1083 \u1091 \u1082 \u1086 \u1074 \u1080 \u1094 \u1072 , \u1075 \u1076 \u1077  \u1087 \u1103 \u1090 \u1100 -\u1096 \u1077 \u1089 \u1090 \u1100 , \u1096 \u1077 \u1089 \u1090 \u1100  \u1083 \u1091 \u1082 \u1086 \u1074 \u1080 \u1094 . \u1060 \u1091 \u1093 , \u1078 \u1072 \u1088 \u1080 \u1090 \u1089 \u1103 . \u1052 \u1091 \u1079 \u1099 \u1082 \u1091  \u1074 \u1082 \u1083 \u1102 \u1095 \u1080 \u1083 , \u1082 \u1086 \u1088 \u1086 \u1095 \u1077 , \u1084 \u1091 \u1079 \u1099 \u1082 \u1072  \u1080 \u1075 \u1088 \u1072 \u1077 \u1090 , \u1090 \u1072 \u1084  \u1076 \u1077 \u1090 \u1080  \u1089 \u1087 \u1072 \u1090 \u1100  \u1083 \u1086 \u1078 \u1072 \u1090 \u1089 \u1103 , \u1084 \u1085 \u1077 , \u1082 \u1086 \u1088 \u1086 \u1095 \u1077 , \u1087 \u1086 \u1092 \u1080 \u1075 . \u1052 \u1091 \u1079 \u1099 \u1082 \u1072  \u1080 \u1075 \u1088 \u1072 \u1077 \u1090 , \u1103  \u1074 \u1077 \u1089 \u1100  \u1090 \u1072 \u1082 \u1086 \u1081  \u1087 \u1072 \u1088 \u1102 \u1082 . \u1052 \u1086 \u1079 \u1075  \u1084 \u1086 \u1081  \u1088 \u1072 \u1073 \u1086 \u1090 \u1072 \u1077 \u1090  \u1086 \u1090  \u1075 \u1083 \u1102 \u1082 \u1086 \u1079 \u1099 . \u1053 \u1091 , \u1079 \u1072 \u1096 \u1080 \u1073 \u1080 \u1089 \u1100 . \u1063 \u1091 \u1074 \u1089 \u1090 \u1074 \u1091 \u1102  \u1089 \u1077 \u1081 \u1095 \u1072 \u1089  \u1087 \u1086 \u1083 \u1085 \u1086 \u1089 \u1090 \u1100 \u1102  \u1089 \u1095 \u1072 \u1089 \u1090 \u1083 \u1080 \u1074 \u1099 \u1084 . \u1056 \u1072 \u1079 \u1076 \u1077 \u1083 \u1080 \u1083  \u1085 \u1072  \u1086 \u1076 \u1085 \u1091  \u1089 \u1082 \u1086 \u1074 \u1086 \u1088 \u1086 \u1076 \u1082 \u1091 , \u1085 \u1072  \u1074 \u1090 \u1086 \u1088 \u1091 \u1102  \u1089 \u1082 \u1086 \u1074 \u1086 \u1088 \u1086 \u1076 \u1082 \u1091  \u1075 \u1088 \u1080 \u1073 \u1099  \u1096 \u1091 \u1082 -\u1096 \u1091 \u1093  \u1090 \u1091 \u1076 \u1072 , \u1075 \u1088 \u1080 \u1073 \u1099  \u1090 \u1091  \u1089 \u1102 \u1076 \u1072 . \u1050 \u1072 \u1087 \u1091 . \u1090 \u1086 \u1095 \u1082 \u1091 , \u1073 \u1083 \u1080 \u1085 , \u1073 \u1091 \u1088 \u1072 \u1095 \u1086 \u1095 \u1077 \u1082 \